# Twitch / IGDB API Configuration (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Analytics
NEXT_PUBLIC_GA_ID=G-G7QH1XG25C

# Firebase Admin SDK (SOMENTE SERVIDOR) — usado para gravar XP/nível e plano premium de
# forma segura, ignorando as Security Rules. Gere em: Firebase Console → Configurações do
# projeto → Contas de serviço → "Gerar nova chave privada". Cole o JSON inteiro (uma linha)
# OU o mesmo JSON codificado em base64. NUNCA exponha isto com prefixo NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# IndexNow (Bing / Yandex / Seznam / Naver) — notificação instantânea de URLs.
# A chave NÃO é secreta: ela é servida publicamente em /<chave>.txt (o arquivo
# public/48fc588eda9f43cbb2e5d4e272fe41d2.txt já está no repositório). Se trocar a
# chave aqui, renomeie o arquivo em public/ para bater com o novo valor.
INDEXNOW_KEY=48fc588eda9f43cbb2e5d4e272fe41d2

# Segredo que libera POST /api/indexnow para automações (cron, GitHub Actions).
# Sem ele, só admin autenticado consegue disparar. Use um valor aleatório longo.
INDEXNOW_SECRET=gere_um_valor_aleatorio_longo_aqui

# Teto de páginas de jogos que o sitemap puxa do registro (game_translations).
# Opcional — o padrão (45.000) já cobre o limite de 50.000 URLs de um sitemap único.
# Cada documento custa 1 leitura no Firestore por regeneração (1x/dia via ISR); em
# 2026-09-08 o registro tinha 11.802 jogos. Reduza este valor se a cota apertar.
SITEMAP_GAME_LIMIT=45000

# Seed da gamificação (scripts/seed-gamification.mjs) — SOMENTE LOCAL, nunca no host.
# Caminho preferido: reutilize FIREBASE_SERVICE_ACCOUNT_KEY acima (ignora as Security Rules).
# Alternativa sem service account: logar como admin verificado da allowlist em firestore.rules.
GV_ADMIN_EMAIL=seu_email_admin@exemplo.com
GV_ADMIN_PASSWORD=sua_senha

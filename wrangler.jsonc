{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-vault",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Backend do cache incremental do OpenNext (ISR). Gratuito no plano Workers.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "14af2ff978f14212a77fb35fe0b4aac2"
    },
    {
      // Flags operacionais alternáveis pelo painel admin (ex.: modo manutenção).
      // Fica no KV porque o middleware consulta em toda requisição — no Firestore
      // isso custaria 1 leitura por request.
      "binding": "APP_CONFIG",
      "id": "ababae0923204d05a480ae3decdf8e96"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyCBeWB14tmyQZZddMia62SpzQ5iTRio8TI",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "gamevault-profile.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "gamevault-profile",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "gamevault-profile.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "310412819391",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:310412819391:web:b61a5616735ef4c3fdbf0a",
    "NEXT_PUBLIC_SITE_URL": "https://game-vault.leandro-gazoli.workers.dev",
    // SITEMAP_GAME_LIMIT foi REMOVIDO de propósito: existia para conter leituras quando o
    // sitemap varria game_translations. Com o índice agregado o custo é ~10 leituras
    // independente do total, e o particionamento (10k URLs por arquivo) cuida do tamanho.
    // Mantê-lo em 3000 truncava o sitemap a 3k das 33k páginas, prejudicando o SEO.
    // FREIO DE EMERGÊNCIA apenas. O controle normal é pelo painel admin (grava no KV
    // APP_CONFIG, que o middleware consulta). Deixe "false": com "true" o site fica
    // bloqueado independentemente do painel, para o caso de o próprio painel estar fora.
    "MAINTENANCE_MODE": "false"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
,

  /**
   * AMBIENTE DE HOMOLOGAÇÃO — worker separado para revisar branches antes do merge.
   *
   * Deploy:  npx wrangler deploy --env homolog
   * URL:     https://game-vault-homolog.<seu-subdominio>.workers.dev
   *
   * KV PRÓPRIO, e isso é essencial: com o namespace compartilhado, ligar o modo manutenção
   * em homologação BLOQUEARIA O SITE REAL, já que o middleware lê a mesma chave. O cache
   * incremental também é separado, senão as duas versões se sobrescreveriam.
   *
   * ⚠️ O FIRESTORE É O MESMO de produção. Não há projeto Firebase separado, então escrita
   * feita em homologação altera dados reais. Use para revisar UI e navegação; evite testar
   * fluxos destrutivos (moderação, concessão de plano, exclusão).
   *
   * ⚠️ SEO: `NEXT_PUBLIC_SITE_URL` aponta para o domínio de homologação e `IS_HOMOLOG`
   * liga o bloqueio total em robots.txt — sem isso o Google indexaria o ambiente e criaria
   * conteúdo duplicado concorrendo com o site real.
   */
  "env": {
    "homolog": {
      "name": "game-vault-homolog",
      "vars": {
        "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyCBeWB14tmyQZZddMia62SpzQ5iTRio8TI",
        "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "gamevault-profile.firebaseapp.com",
        "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "gamevault-profile",
        "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "gamevault-profile.firebasestorage.app",
        "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "310412819391",
        "NEXT_PUBLIC_FIREBASE_APP_ID": "1:310412819391:web:b61a5616735ef4c3fdbf0a",
        "NEXT_PUBLIC_SITE_URL": "https://game-vault-homolog.leandro-gazoli.workers.dev",
        "MAINTENANCE_MODE": "false",
        "IS_HOMOLOG": "true",
        // Sitemap curto: homologação não é indexada, então não há motivo para gastar
        // leitura do Firestore montando 33 mil URLs aqui.
        "SITEMAP_GAME_LIMIT": "50"
      },
      // Namespaces PRÓPRIOS, separados dos de produção. O isolamento é o ponto todo:
      //
      // - `APP_CONFIG` guarda a flag de manutenção. Compartilhar significaria que ligar
      //   manutenção em homologação DERRUBARIA O SITE REAL, já que o middleware lê a mesma
      //   chave.
      // - `NEXT_INC_CACHE_KV` guarda o cache incremental. Compartilhado, as duas versões se
      //   sobrescreveriam e você revisaria páginas de produção achando que são da branch.
      //
      // Custo: cada deploy aqui popula o cache (~115 escritas) na cota da conta, hoje de
      // 1 mi/mês no Workers Paid. Era proibitivo no gratuito (1.000/dia); deixou de ser.
      "kv_namespaces": [
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "5ba84aafacf245cdb8fa9e0efe5dcba8"
        },
        {
          "binding": "APP_CONFIG",
          "id": "439b6f94d9304d1cbafaff7b7f2f597d"
        }
      ],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      }
    }
  }
}

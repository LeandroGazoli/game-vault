rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para perfis de usuário
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Regras para jogos do usuário
      match /games/{gameId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

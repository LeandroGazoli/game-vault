rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para configurações do sistema e planos da plataforma
    match /system/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ["leandro.gazolig@gmail.com"];
    }

    // Regras para perfis de usuário
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email in ["leandro.gazolig@gmail.com"]
      );

      // Regras para jogos do usuário
      match /games/{gameId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.token.email in ["leandro.gazolig@gmail.com"]
        );
      }
    }

    // Cache público de traduções de jogos (100% gratuito e permanente)
    match /game_translations/{gameId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

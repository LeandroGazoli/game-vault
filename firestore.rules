rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validação estrita de Admin: requer autenticação, email na lista permitida E verificado
    function isVerifiedAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ["leandro.gazolig@gmail.com"];
    }

    // Regras para configurações do sistema e planos da plataforma
    match /system/{document=**} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    // Regras para perfis de usuário
    match /users/{userId} {
      // Leitura pública permitida para consulta de perfis e buscas por username
      allow read: if true;

      // Criação inicial de conta: usuário comum só pode criar conta gratuita e sem privilégios
      allow create: if isVerifiedAdmin() || (
        isOwner(userId) &&
        request.resource.data.plan == "free" &&
        request.resource.data.isAdmin == false &&
        request.resource.data.isPremium == false &&
        (!('banned' in request.resource.data) || request.resource.data.banned == false) &&
        (!('suspended' in request.resource.data) || request.resource.data.suspended == false) &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
        (!('hideAds' in request.resource.data) || request.resource.data.hideAds == false) &&
        (!('gamerXp' in request.resource.data) || request.resource.data.gamerXp == 0) &&
        (!('gamerLevel' in request.resource.data) || request.resource.data.gamerLevel <= 1) &&
        (!('bonusXp' in request.resource.data) || request.resource.data.bonusXp == 0) &&
        (!('claimedRewards' in request.resource.data) || request.resource.data.claimedRewards.size() == 0) &&
        (!('customTitles' in request.resource.data) || request.resource.data.customTitles.size() == 0) &&
        (!('createdCustomTitles' in request.resource.data) || request.resource.data.createdCustomTitles.size() == 0)
      );

      // Atualização de perfil: impede que o próprio usuário mude plano, se promova a admin, remova
      // suspensões, forje XP/nível, se auto-verifique, remova anúncios ou conceda títulos/recompensas.
      // (Prevenção de BOPLA / Mass Assignment). Estes campos só são escritos pelo servidor (Admin SDK).
      allow update: if isVerifiedAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'plan', 'isAdmin', 'isPremium', 'premiumUntil', 'email', 'uid', 'username', 'banned', 'suspended', 'moderationReason', 'moderatedAt',
          'gamerXp', 'gamerLevel', 'bonusXp', 'claimedRewards', 'isVerified', 'hideAds', 'customTitles', 'createdCustomTitles'
        ])
      );

      // Deleção permitida apenas pelo próprio usuário ou admin verificado
      allow delete: if isOwner(userId) || isVerifiedAdmin();

      // Regras para jogos do usuário
      match /games/{gameId} {
        allow read: if true;
        allow write: if isOwner(userId) || isVerifiedAdmin();
      }
    }

    // Cache público de traduções de jogos: protegido contra DoS, injeção de campos e overflow de armazenamento
    match /game_translations/{gameId} {
      allow read: if true;
      allow create, update: if
        isAuthenticated() &&
        request.resource.data.source == "free_engine" &&
        request.resource.data.keys().hasOnly([
          'gameId', 'gameName', 'originalText', 'translatedText',
          'originalStoryline', 'translatedStoryline', 'source', 'updatedAt', 'createdAt'
        ]) &&
        (!('translatedText' in request.resource.data) || (request.resource.data.translatedText is string && request.resource.data.translatedText.size() <= 25000)) &&
        (!('translatedStoryline' in request.resource.data) || (request.resource.data.translatedStoryline is string && request.resource.data.translatedStoryline.size() <= 25000));
      allow delete: if isVerifiedAdmin();
    }

    // Central Comunitária de Feedback, Ideias, Votação e Recompensas
    match /feedback/{feedbackId} {
      allow read: if true;

      // Criação de feedback: usuário autenticado, autor correspondente, status inicial 'under_review' e contadores zerados
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.status == "under_review" &&
        request.resource.data.score == 0 &&
        request.resource.data.upvotesCount == 0 &&
        request.resource.data.downvotesCount == 0 &&
        request.resource.data.commentsCount == 0 &&
        request.resource.data.category in ["idea", "bug", "improvement", "feedback"] &&
        (!('rewarded' in request.resource.data) || request.resource.data.rewarded == false) &&
        (!('adminResponse' in request.resource.data) || request.resource.data.adminResponse == null) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 5 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 15 &&
        request.resource.data.description.size() <= 3000;

      // Atualização: Admin verificado tem controle total. Os CONTADORES DE VOTO (upvotesCount,
      // downvotesCount, score) NÃO são mais graváveis pelo cliente — só pelo servidor via Admin SDK
      // (/api/feedback/vote), impedindo forja de score. Cliente comum só pode:
      //  - incrementar commentsCount (ao criar comentário), ou
      //  - o próprio autor editar o texto (sem tocar em status/recompensa/contadores de voto).
      allow update: if isVerifiedAdmin() || (
        isAuthenticated() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'commentsCount', 'updatedAt'
          ]) ||
          (
            resource.data.authorId == request.auth.uid &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'status', 'adminResponse', 'adminResponseAt', 'rewarded', 'rewardType', 'rewardTitle', 'rewardGrantedAt', 'authorId',
              'upvotesCount', 'downvotesCount', 'score'
            ])
          )
        )
      );

      // Deleção permitida apenas pelo autor da sugestão ou admin verificado
      allow delete: if isVerifiedAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      // Ledger de voto: leitura pública (a UI mostra o voto do usuário), mas escrita só pelo
      // servidor (Admin SDK) — impede manipular o próprio ledger para reinflar contadores.
      match /votes/{userId} {
        allow read: if true;
        allow write: if isVerifiedAdmin();
      }

      // Discussões e comentários da comunidade
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() >= 3 &&
          request.resource.data.content.size() <= 1000 &&
          // Impede que usuário comum se passe por resposta oficial da equipe
          (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false || isVerifiedAdmin());
        // Autor pode editar o próprio comentário, mas não pode se auto-promover a admin nem trocar o autor
        allow update: if isVerifiedAdmin() || (
          isAuthenticated() && resource.data.authorId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'authorId'])
        );
        allow delete: if isVerifiedAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      }
    }

    // Notificações e Avisos do Sistema (Push & In-App)
    match /system_notifications/{notifId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    // Trilha de Auditoria Administrativa: estritamente privada, legível apenas por admin, imutável
    match /audit_logs/{logId} {
      allow read: if isVerifiedAdmin();
      // Apenas admin verificado pode criar registros de auditoria; update e delete são PROIBIDOS (imutabilidade)
      allow create: if isVerifiedAdmin() &&
        request.resource.data.adminEmail is string &&
        request.resource.data.action is string &&
        request.resource.data.action.size() <= 100 &&
        request.resource.data.createdAt is string;
      allow update, delete: if false;
    }
  }
}
